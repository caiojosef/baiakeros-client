MainWindow
  id: authenticatorWindow
  !text: tr('Autenticacao de dois fatores')
  size: 390 260
  @onEscape: EnterGame.cancelAuthenticator()
  @onEnter: EnterGame.submitAuthenticator()

  Label
    id: instruction
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 34
    text-wrap: true
    text: Digite os 6 numeros do autenticador ou um codigo de recuperacao da sua conta.

  TextEdit
    id: tokenEdit
    anchors.top: instruction.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    height: 28
    max-length: 64
    @onEnter: EnterGame.submitAuthenticator()

  Label
    id: errorLabel
    anchors.top: tokenEdit.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 58
    color: #eeaa77
    text-wrap: true

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: confirmButton.top
    margin-bottom: 12

  Button
    id: confirmButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 105
    text: Entrar
    @onClick: EnterGame.submitAuthenticator()

  Button
    id: cancelButton
    anchors.bottom: parent.bottom
    anchors.right: confirmButton.left
    margin-right: 8
    width: 90
    text: Cancelar
    @onClick: EnterGame.cancelAuthenticator()
