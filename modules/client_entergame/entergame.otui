EnterGameWindow < MainWindow
  !text: tr('Enter Game')
  size: 236 316


EnterGameButton < Button
  width: 64

ServerListButton < UIButton
  size: 17 17
  image-source: /images/topbuttons/minimap
  image-color: #ffffffff

  $hover !disabled:
    image-color: #ffffff99

  $pressed:
    image-color: #ffffff44

  $disabled:
    image-color: #ffffff55

SavedAccountsButton < UIButton
  size: 19 20
  image-source: /images/ui/button-grey-up
  image-border: 5
  icon-source: /images/ui/icon-arrow7x7-down
  icon-size: 7 7
  icon-offset: 6 6
  !tooltip: tr('Saved accounts on this computer')

  $pressed:
    image-source: /images/ui/button-grey-down
    icon-offset: 7 7

  $on:
    image-source: /images/ui/button-grey-down
    icon-offset: 7 7

SavedAccountMenuEntry < UIWidget
  height: 20

  UIButton
    id: emailButton
    anchors.left: parent.left
    anchors.right: removeButton.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-right: 2
    padding-left: 4
    text-align: left
    font: verdana-11px-rounded
    color: white
    background-color: alpha

    $hover:
      background-color: #ffffff24

    $pressed:
      background-color: #ffffff36

  UIButton
    id: removeButton
    size: 18 18
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/ui/button-clear-18x18-up

    $hover:
      image-color: #ffffffff

    $pressed:
      image-source: /images/ui/button-clear-18x18-down

EnterGameWindow
  id: enterGame
  &authenticatorEnabled: false
  &authenticatorHeight: 44
  &stayLoggedBoxEnabled: false
  &stayLoggedBoxHeight: 24
  size: 280 285
  @onEnter: EnterGame.doLogin()

  Label
    id: emailLabel
    !text: tr('Acc Name:')
    font: verdana-11px-antialised
    anchors.left: parent.left
    anchors.top: parent.top

    opacity: 0.8


  Label
    id: passwordLabel
    !text: tr('Password:')
    font: verdana-11px-antialised
    anchors.left: emailLabel.left
    anchors.top: emailLabel.bottom
    margin-top: 10
    opacity: 0.8

  TextQtEdit
    id: accountNameTextEdit
    font: verdana-11px-antialised
    padding-right: 22
    anchors.right: accountPasswordTextEdit.right
    anchors.verticalCenter: emailLabel.verticalCenter
    anchors.left: accountPasswordTextEdit.left

  SavedAccountsButton
    id: savedAccountsButton
    anchors.right: accountNameTextEdit.right
    anchors.verticalCenter: accountNameTextEdit.verticalCenter
    @onClick: EnterGame.showSavedAccounts()
    
  HiddenTextQtToggleEdit
    id: accountPasswordTextEdit
    font: verdana-11px-antialised
    anchors.right: parent.right
    anchors.left: passwordLabel.right
    anchors.verticalCenter: passwordLabel.verticalCenter
    margin-left: 5

  QtCheckBox
    id: rememberEmailBox
    !text: tr('Remember Email')
    !tooltip: tr('Remember email when starting the client')
    font: verdana-11px-antialised
    anchors.left: passwordLabel.left
    anchors.right: parent.right
    anchors.top: accountPasswordTextEdit.bottom
    margin-top: 8
    opacity: 0.8

  QtCheckBox
    id: rememberPasswordBox
    !text: tr('Remember Password')
    !tooltip: tr('Remember password when starting the client')
    font: verdana-11px-antialised
    anchors.left: rememberEmailBox.left
    anchors.right: parent.right
    anchors.top: rememberEmailBox.bottom
    margin-top: 5
    opacity: 0.8

  UIButton
    !text: tr('Forgot Password')
    id: Forgot_password_email
    font: verdana-11px-monochrome-underline
    text-align: left
    anchors.left: rememberEmailBox.left
    anchors.right: parent.right
    anchors.top: rememberPasswordBox.bottom
    opacity: 0.8
    margin-top: 5
    @onClick: g_platform.openUrl(Services.forgotPassword or Services.websites)
    @onSetup: |
        if Services and (Services.forgotPassword or Services.websites) then
            self:setVisible(true)
        else
            self:setVisible(false)
            self:hide()
        end

  QtCheckBox
    id: stayLoggedBox
    !text: tr('Stay logged during session')
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 6
    margin-top: -16
    visible: false

    $on:
      visible: true
      margin-top: 8

  MenuLabel
    id: serverLabel
    !text: tr('Server')
    anchors.left: prev.left
    anchors.top: prev.bottom
    margin-top: 8
    text-auto-resize: true

  ServerListButton
    id: serverListButton
    !tooltip: tr('Server list')
    anchors.right: parent.right
    anchors.top: serverLabel.bottom
    margin-top: 3
    @onClick: EnterGame.showServerList()

  TextEdit
    id: serverHostTextEdit
    !tooltip: tr('Make sure that your client uses\nthe correct game client version')
    anchors.left: parent.left
    anchors.right: serverListButton.left
    anchors.top: serverLabel.bottom
    margin-top: 2
    margin-right: 4

  MenuLabel
    id: clientLabel
    !text: tr('Client Version')
    anchors.left: parent.left
    anchors.top: serverHostTextEdit.bottom
    text-auto-resize: true
    margin-right: 10
    margin-top: 8

  ComboBox
    id: clientComboBox
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: clientLabel.bottom
    margin-top: 2
    margin-right: 3
    width: 90
    menu-scroll: true
    menu-height: 125
    menu-scroll-step: 25

  MenuLabel
    id: portLabel
    !text: tr('Port')
    anchors.left: serverPortTextEdit.left
    anchors.top: serverHostTextEdit.bottom
    margin-top: 8
    text-auto-resize: true

  TextEdit
    id: serverPortTextEdit
    text: 7171
    anchors.right: parent.right
    anchors.left: parent.horizontalCenter
    anchors.top: clientComboBox.top
    margin-left: 3

  QtCheckBox
    id: httpLoginBox
    enabled: true
    !text: tr('Enable HTTP login')
    !tooltip: tr('If login fails using HTTPS (encrypted) try with HTTP (unencrypted)')
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 6

  QtButton
    !text: tr('Login')
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 9
    size: 86 20
    @onClick: EnterGame.doLogin()

  QtButton
    id: btnCreateNewAccount
    !text: tr('Create New Account')
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: -17
    size: 109 20
    @onClick: g_platform.openUrl(Services.createAccount)

    @onSetup: |
      if Services and Servers_init and table.size(Servers_init) == 1 and Services.createAccount then
        self:setVisible(true)
      else
        self:setVisible(false)
      end

  Label
    id: serverInfoLabel
    font: verdana-11px-rounded
    anchors.top: prev.top
    anchors.left: parent.left
    margin-top: 5
    color: green
    text-auto-resize: true
