BaiakerosPartyHuntPanel < UIWidget
  anchors.fill: parent

  HelperV2Section
    id: partyControlColumn
    width: 310
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom

    Label
      text: Party Hunt
      color: #ffffff
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 5

    Label
      id: partyTime
      text: --:--:--
      size: 106 22
      text-align: center
      background-color: #383838
      color: #ffffff
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 31

    UIProgressBar
      id: partyProgress
      size: 240 14
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: partyTime.bottom
      margin-top: 5
      background-color: #63d897
      border-width: 1
      border-color: #f0d48a

    Label
      id: partyMembersTitle
      text: Party - Up to 4 Players
      color: #ffffff
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: partyProgress.bottom
      margin-top: 18

    Label
      id: partyMember1
      text: 1. ---
      size: 280 22
      color: #f0d48a
      anchors.left: parent.left
      anchors.top: partyMembersTitle.bottom
      margin-left: 15
      margin-top: 10

    Label
      id: partyMember2
      text: 2. ---
      size: 280 22
      color: #ffffff
      anchors.left: prev.left
      anchors.top: prev.bottom
      margin-top: 6

    Label
      id: partyMember3
      text: 3. ---
      size: 280 22
      color: #ffffff
      anchors.left: prev.left
      anchors.top: prev.bottom
      margin-top: 6

    Label
      id: partyMember4
      text: 4. ---
      size: 280 22
      color: #ffffff
      anchors.left: prev.left
      anchors.top: prev.bottom
      margin-top: 6

    SmallButton
      id: partyRefresh
      text: Refresh Party
      size: 240 22
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: partyMember4.bottom
      margin-top: 8

    QtButton
      id: partyStart
      text: Start
      size: 122 25
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: partyRefresh.bottom
      margin-top: 12
      margin-left: -16

    SmallButton
      id: partyFloat
      text: _
      size: 25 25
      anchors.left: partyStart.right
      anchors.top: partyStart.top
      margin-left: 5
      !tooltip: tr('Open the floating Party Hunt window')

    SmallButton
      id: partyTeleport
      text: Teleport to leader
      size: 280 25
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: partyStart.bottom
      margin-top: 12
      !tooltip: tr('Leader only. Everyone must be in protection zone. Cooldown: 10 minutes.')

    Label
      id: partyWarning
      color: #f0d48a
      text-wrap: true
      text-auto-resize: true
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: partyTeleport.bottom
      margin: 12 15 0 15

    Label
      id: partyStatus
      text: Entre em uma party para comecar
      color: #ffffff
      text-wrap: true
      text-auto-resize: true
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 0 15 12 15

  UIWidget
    id: partyDivider
    width: 1
    background-color: #747474
    anchors.left: partyControlColumn.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin: 8 0 8 10

  HelperV2Section
    id: partyExtrasColumn
    anchors.left: partyDivider.right
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 10

    SmallButton
      id: partyExtrasTab
      text: Extras
      size: 110 25
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 7
      on: true
      enabled: false

    HorizontalSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: partyExtrasTab.bottom
      margin: 8 10 0 10

    Label
      id: partyDruidOptionsTitle
      text: Personal Movement
      color: #f0d48a
      anchors.left: parent.left
      anchors.top: partyExtrasTab.bottom
      margin: 30 20 0 20

    Label
      id: partyToleranceLabel
      text: Run from (monsters)
      anchors.left: partyDruidOptionsTitle.left
      anchors.top: partyDruidOptionsTitle.bottom
      margin-top: 18

    ComboBox
      id: partyRunThreshold
      size: 54 22
      anchors.left: partyToleranceLabel.right
      anchors.verticalCenter: partyToleranceLabel.verticalCenter
      margin-left: 12
      !tooltip: tr('Start circling when this many monsters have recently damaged you, including area attacks. For example, 3 means run from the third attacker; 1 or 2 remain below the limit.')

    CheckBox
      id: partyAlwaysRun
      text: Always run (runes)
      size: 240 18
      anchors.left: partyDruidOptionsTitle.left
      anchors.top: partyRunThreshold.bottom
      margin-top: 18

    HorizontalSeparator
      id: partyOptionsSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: partyAlwaysRun.bottom
      margin: 18 20 0 20

    Label
      id: partyMovementHelp
      !text: tr('Each player configures their own movement. Knight and Elite Knight do not have distance options.\n\nBelow the chosen count: hold and face the box.\nAt or above it: circle clockwise, 3 to 5 SQMs from the visible box. Setting 3 means run from the third attacker. Reverse only to avoid obstacles; use free diagonal exits. Pause between steps to cast.\n\nAlways run: keep moving and use the runes configured in Attack.\n\nOnly ready Shooter spells change your casting position; individual and all group cooldowns apply.\nDruid / Sorcerer: nearest cardinal slot at 3 SQMs.\nDruid - Earth Wave: 4 SQMs.\nDruid - Strong Ice Wave and Ulus: 3 SQMs.\nDruid - Gran Mas Frigo / Tera: 2 SQMs when holding; at least 3 while circling.\nRescue: another floor, over 5 SQMs away or hidden for 3 seconds; return to a visible free tile 3 SQMs away.')
      color: #d0d0d0
      text-wrap: true
      text-auto-resize: true
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: partyOptionsSeparator.bottom
      margin: 14 20 0 20

    Label
      id: partyKnightNotice
      text: Knight and Elite Knight do not have distance options.
      color: #d0d0d0
      text-wrap: true
      text-auto-resize: true
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: partyDruidOptionsTitle.bottom
      margin: 18 20 0 20
      visible: false

BaiakerosPartyHuntFloat < MainWindow
  text: Party Hunt
  size: 286 350
  anchors.centerIn: parent
  visible: false
  @onEscape: modules.game_baiakeros_helper_v2.PartyHuntV2.closeFloating()

  SmallButton
    id: partyFloatBack
    text: Back to Helper
    size: 112 22
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 8
    margin-top: 4

  SmallButton
    id: partyFloatMinimize
    text: Minimize
    size: 68 22
    anchors.right: parent.right
    anchors.top: partyFloatBack.top
    margin-right: 8

  SmallButton
    id: partyFloatExpand
    text: Expand
    size: 68 22
    anchors.right: parent.right
    anchors.top: partyFloatBack.top
    margin-right: 8
    visible: false

  Label
    id: partyFloatTime
    text: --:--:--
    color: #ffffff
    size: 106 22
    text-align: center
    background-color: #383838
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: partyFloatBack.bottom
    margin-top: 10

  UIProgressBar
    id: partyFloatProgress
    size: 210 16
    background-color: #63d897
    border-width: 1
    border-color: #f0d48a
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: partyFloatTime.bottom
    margin-top: 5

  QtButton
    id: partyFloatStop
    text: Stop
    color: #ffffff
    size: 130 26
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: partyFloatProgress.bottom
    margin-top: 6

  Label
    id: partyFloatRoster
    text: 1. ---
    color: #ffffff
    size: 240 72
    text-wrap: true
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: partyFloatStop.bottom
    margin-top: 6

  UIWidget
    id: partyFloatDetails
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: partyFloatRoster.bottom
    anchors.bottom: parent.bottom
    margin-top: 8

    Label
      id: partyFloatGuide
      text: No guide
      color: #f0d48a
      size: 240 18
      text-align: center
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top

    Label
      id: partyFloatStatus
      text: Waiting for Party Hunt
      color: #ffffff
      text-wrap: true
      text-auto-resize: true
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: partyFloatGuide.bottom
      margin: 8 10 0 10
