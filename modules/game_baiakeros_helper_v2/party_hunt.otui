BaiakerosPartyHuntPanel < UIWidget
  anchors.fill: parent

  HelperV2Section
    id: partyControlColumn
    width: 310
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom

    Label
      text: Party Hunt
      color: #ffffff
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 5

    Label
      id: partyTime
      text: --:--:--
      size: 106 22
      text-align: center
      background-color: #383838
      color: #ffffff
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 31

    UIProgressBar
      id: partyProgress
      size: 240 14
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: partyTime.bottom
      margin-top: 5
      background-color: #63d897
      border-width: 1
      border-color: #f0d48a

    Label
      id: partyMembersTitle
      text: Party - Up to 4 Players
      color: #ffffff
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: partyProgress.bottom
      margin-top: 18

    Label
      id: partyMember1
      text: 1. ---
      size: 280 22
      color: #f0d48a
      anchors.left: parent.left
      anchors.top: partyMembersTitle.bottom
      margin-left: 15
      margin-top: 10

    Label
      id: partyMember2
      text: 2. ---
      size: 280 22
      color: #ffffff
      anchors.left: prev.left
      anchors.top: prev.bottom
      margin-top: 6

    Label
      id: partyMember3
      text: 3. ---
      size: 280 22
      color: #ffffff
      anchors.left: prev.left
      anchors.top: prev.bottom
      margin-top: 6

    Label
      id: partyMember4
      text: 4. ---
      size: 280 22
      color: #ffffff
      anchors.left: prev.left
      anchors.top: prev.bottom
      margin-top: 6

    SmallButton
      id: partyRefresh
      text: Refresh Party
      size: 240 22
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: partyMember4.bottom
      margin-top: 8

    QtButton
      id: partyStart
      text: Start
      size: 122 25
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: partyRefresh.bottom
      margin-top: 12
      margin-left: -16

    SmallButton
      id: partyFloat
      text: _
      size: 25 25
      anchors.left: partyStart.right
      anchors.top: partyStart.top
      margin-left: 5
      !tooltip: tr('Open the floating Party Hunt window')

    Label
      id: partyWarning
      color: #f0d48a
      text-wrap: true
      text-auto-resize: true
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: partyStart.bottom
      margin: 12 15 0 15

    Label
      id: partyStatus
      text: Entre em uma party para comecar
      color: #ffffff
      text-wrap: true
      text-auto-resize: true
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 0 15 12 15

  UIWidget
    id: partyDivider
    width: 1
    background-color: #747474
    anchors.left: partyControlColumn.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin: 8 0 8 10

  HelperV2Section
    id: partyExtrasColumn
    anchors.left: partyDivider.right
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 10

    Label
      text: Party Hunt
      color: #ffffff
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 5

    UIWidget
      id: partyVocationSection
      height: 205
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      margin: 36 20 0 20

      Label
        id: partyDruidOptionsTitle
        text: Configurações da vocação
        color: #f0d48a
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        text-align: left
        margin: 0 0 0 0

      Label
        id: partyToleranceLabel
        text: Correr a partir de (monstros)
        anchors.left: partyDruidOptionsTitle.left
        anchors.top: partyDruidOptionsTitle.bottom
        margin-top: 18

      ComboBox
        id: partyRunThreshold
        size: 54 22
        anchors.left: partyToleranceLabel.right
        anchors.verticalCenter: partyToleranceLabel.verticalCenter
        margin-left: 12
        !tooltip: tr('Começa a circular ao atingir esta quantidade de monstros causando dano, incluindo ataques em área. Exemplo: 3 começa a correr no terceiro atacante.')

      CheckBox
        id: partyAlwaysRun
        text: Sempre correr (somente runas)
        size: 240 18
        anchors.left: partyDruidOptionsTitle.left
        anchors.top: partyRunThreshold.bottom
        margin-top: 18

      HorizontalSeparator
        id: partyOptionsSeparator
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: partyRunThreshold.bottom
        margin: 52 0 0 0

      Label
        id: partyPaladinModeLabel
        text: Posição do Paladin
        anchors.left: partyDruidOptionsTitle.left
        anchors.top: partyRunThreshold.bottom
        margin-top: 18
        visible: false

      ComboBox
        id: partyPaladinMode
        size: 180 22
        anchors.left: partyPaladinModeLabel.right
        anchors.verticalCenter: partyPaladinModeLabel.verticalCenter
        margin-left: 12
        !tooltip: tr('Escolha a movimentação do Paladin. Exevo mas san pronta usa uma posição livre a 2 SQMs do líder, no norte, sul, leste ou oeste.')
        visible: false

      Label
        id: partyMonkModeLabel
        text: Posição do Monk
        anchors.left: partyDruidOptionsTitle.left
        anchors.top: partyRunThreshold.bottom
        margin-top: 18
        visible: false

      ComboBox
        id: partyMonkMode
        size: 180 22
        anchors.left: partyMonkModeLabel.right
        anchors.verticalCenter: partyMonkModeLabel.verticalCenter
        margin-left: 12
        !tooltip: tr('Fique a 2 SQMs virado para a box ou circule e pare nessa distância para lançar cada magia pronta do Shooter.')
        visible: false

      Label
        id: partyMovementHelp
        !text: tr('O mage para virado para a box e ajusta a posição à próxima magia pronta do Shooter.\n\nAo atingir a quantidade escolhida de atacantes, circula ao redor da box, normalmente entre 3 e 5 SQMs, e pausa para lançar magias. Sempre correr mantém o movimento e usa somente runas.')
        color: #d0d0d0
        text-wrap: true
        text-auto-resize: true
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: partyOptionsSeparator.bottom
        margin: 12 0 0 0

      Label
        id: partyKnightNotice
        text: Knight e Elite Knight não possuem configurações de distância. O líder controla o caminho; ataque e cura são configurados no Helper.
        color: #d0d0d0
        text-wrap: true
        text-auto-resize: true
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: partyDruidOptionsTitle.bottom
        margin: 14 0 0 0
        visible: false

    HorizontalSeparator
      id: partyTutorialSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: partyVocationSection.bottom
      margin: 12 20 0 20

    Label
      id: partyTutorialTitle
      text: Como usar o Party Hunt
      color: #f0d48a
      anchors.left: partyTutorialSeparator.left
      anchors.top: partyTutorialSeparator.bottom
      margin-top: 14

    Label
      id: partyTutorialText
      !text: tr('1. Forme uma party com até 4 jogadores. O líder aperta Start; os membros seguem automaticamente, sem abrir o Helper. O líder anda manualmente ou pelo Cavebot.\n\n2. Configure cura, magias e runas no Helper de cada jogador. Fora da protection zone, Auto Target e Shooter seguem as opções do líder; o alvo também é compartilhado.\n\n3. Cada membro ajusta sua movimentação acima. No minimizado, Stop pausa só esse membro; Resume retoma. O Stop do líder para todos.\n\n4. Os membros só saem da protection zone após o líder. PvP (PZ lock/skull), queda ou morte do líder interrompem o Party Hunt.')
      color: #d0d0d0
      text-wrap: true
      text-auto-resize: true
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: partyTutorialTitle.bottom
      margin: 12 20 0 20

BaiakerosPartyHuntFloat < MainWindow
  text: Party Hunt
  size: 286 350
  anchors.centerIn: parent
  visible: false
  @onEscape: modules.game_baiakeros_helper_v2.PartyHuntV2.closeFloating()

  SmallButton
    id: partyFloatBack
    text: Back to Helper
    size: 112 22
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 8
    margin-top: 4

  SmallButton
    id: partyFloatMinimize
    text: Minimize
    size: 68 22
    anchors.right: parent.right
    anchors.top: partyFloatBack.top
    margin-right: 8

  SmallButton
    id: partyFloatExpand
    text: Expand
    size: 68 22
    anchors.right: parent.right
    anchors.top: partyFloatBack.top
    margin-right: 8
    visible: false

  Label
    id: partyFloatTime
    text: --:--:--
    color: #ffffff
    size: 106 22
    text-align: center
    background-color: #383838
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: partyFloatBack.bottom
    margin-top: 10

  UIProgressBar
    id: partyFloatProgress
    size: 210 16
    background-color: #63d897
    border-width: 1
    border-color: #f0d48a
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: partyFloatTime.bottom
    margin-top: 5

  QtButton
    id: partyFloatStop
    text: Stop
    color: #ffffff
    size: 130 26
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: partyFloatProgress.bottom
    margin-top: 6

  UIWidget
    id: partyFloatLeverControls
    height: 44
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: partyFloatStop.bottom
    margin-top: 6
    visible: false

    CheckBox
      id: partyFloatBossLever
      text: Boss lever
      size: 136 18
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 8
      !tooltip: tr('Stand on the first lever tile and face the remaining tiles. Party slots 2, 3 and 4 line up one SQM apart. Paused members do not move. Using the boss lever clears this option.')

    SmallButton
      id: partyFloatLeverHotkey
      text: Set hotkey
      size: 88 22
      anchors.right: parent.right
      anchors.top: parent.top
      margin-right: 8

  Label
    id: partyFloatRoster
    text: 1. ---
    color: #ffffff
    size: 240 72
    text-wrap: true
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: partyFloatLeverControls.bottom
    margin-top: 6

  UIWidget
    id: partyFloatDetails
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: partyFloatRoster.bottom
    anchors.bottom: parent.bottom
    margin-top: 8

    Label
      id: partyFloatGuide
      text: No guide
      color: #f0d48a
      size: 240 18
      text-align: center
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top

    Label
      id: partyFloatStatus
      text: Waiting for Party Hunt
      color: #ffffff
      text-wrap: true
      text-auto-resize: true
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: partyFloatGuide.bottom
      margin: 8 10 0 10
