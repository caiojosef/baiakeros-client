    anchors.top: v2CavebotExpandButton.bottom
    anchors.bottom: parent.bottom
    margin-top: 3
    visible: false

    Label
      id: v2CavebotCompactTime
      text: 03:00:00
      color: #ffffff
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 8

    Label
      id: v2CavebotCompactPercent
      text: 100%
      color: #63d897
      anchors.right: parent.right
      anchors.verticalCenter: v2CavebotCompactTime.verticalCenter
      margin-right: 30

    UIWidget
      id: v2CavebotCompactProgressFrame
      size: 210 20
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: v2CavebotCompactTime.bottom
      margin-top: 6
      background-color: #13191b
      border-width: 1
      border-color: #9b814d

      UIProgressBar
        id: v2CavebotCompactProgress
        anchors.fill: parent
        margin: 3 3 3 3
        background-color: #63d897
        phantom: true

    QtButton
      id: v2CavebotCompactStopButton
      text: Stop
      color: #ffffff
      size: 130 26
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: v2CavebotCompactProgressFrame.bottom
      margin-top: 6
      @onClick: modules.game_baiakeros_helper_v2.stopFromCompactCavebot()

  UIWidget
    id: v2CavebotFloatSlot
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: v2CavebotReturnButton.bottom
    anchors.bottom: parent.bottom
    margin-top: 5
