    size: 14 24
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 73

  UIWidget
    size: 46 24
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/ui/button
    image-border: 3

    Label
      text: 0%
      anchors.fill: parent
      text-align: center
      color: #eeeeee

  SmallButton
    text: >
    size: 14 24
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter

  SmallButton
    text: <
    size: 14 24
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 176

  UIWidget
    size: 36 24
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/ui/button
    image-border: 3

    Label
      text: 1
      anchors.fill: parent
      text-align: center
      color: #eeeeee

  SmallButton
    text: >
    size: 14 24
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter

  QtComboBox
    id: priorityBox
    size: 70 24
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 280
    mouse-scroll: false

BaiakerosHelperV2Window < MainWindow
  id: baiakerosHelperV2Window
  !text: tr('BaiakEros Helper V2 - Healing')
  size: 840 610
  anchors.centerIn: parent
  visible: false
  @onEscape: modules.game_baiakeros_helper_v2.hide()

  UIWidget
    id: navigationBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    height: 36
    background-color: #404040
    border-width-top: 1
    border-color-top: black
    border-width-left: 1
    border-color-left: black
    border-width-bottom: 1
    border-color-bottom: #747474
    border-width-right: 1
    border-color-right: #747474

    UIButton
      id: healingToolsTab
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 1
      size: 668 36
      @onClick: modules.game_baiakeros_helper_v2.showHelperV2Tab('healing')
      $on:
        size: 150 34
        image-clip: 0 0 150 34
        image-source: /images/baiakeros/helper-v2-healing_on
      $!on:
        size: 34 34
        image-clip: 0 0 34 34
        image-source: /images/baiakeros/helper-v2-healing_off
      $pressed:
        size: 34 34
        image-clip: 0 34 34 34
        image-source: /images/baiakeros/helper-v2-healing_off

    UIButton
      id: attackTab
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 1
      @onClick: modules.game_baiakeros_helper_v2.showHelperV2Tab('attack')
      $on:
        size: 150 34
        image-clip: 0 0 150 34
        image-source: /images/baiakeros/helper-v2-attack_on
      $!on:
        size: 34 34
        image-clip: 0 0 34 34
        image-source: /images/baiakeros/helper-v2-attack_off
      $pressed:
        size: 34 34
        image-clip: 0 34 34 34
        image-source: /images/baiakeros/helper-v2-attack_off
  UIWidget
    id: contentContainer
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: navigationBar.bottom
    anchors.bottom: bottomSeparator.top
    margin-top: 7
    margin-bottom: 7

    UIWidget
      id: healingToolsPage
      anchors.fill: parent

      HelperV2Section
        id: healingSection
        anchors.left: parent.left
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        width: 398
        margin-left: 6

        Label
          text: Healing
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: parent.top
          margin-top: 6
          font: verdana-11px-antialised
          color: #dfdfdf

        UIWidget
          id: healingPresetPanel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: parent.top
          height: 27
          margin-left: 10
          margin-right: 10
          margin-top: 29

          Label
            text: Preset
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            color: #cfcfcf

          QtComboBox
            id: v2HealingPresetBox
            size: 108 22
            anchors.left: prev.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 6
            mouse-scroll: false

          SmallButton
            text: +
            size: 22 20
            anchors.left: prev.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 5

          SmallButton
            text: x
            size: 22 20
            anchors.left: prev.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 4

          SmallButton
            text: Set Hotkey
            size: 70 20
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter

        VerticalSeparator
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: healingPresetPanel.bottom
          anchors.bottom: healingBottomPanel.top
          margin-top: 10
          margin-bottom: 8

        UIWidget
          id: spellHealingColumn
          width: 186
          anchors.left: parent.left
          anchors.top: healingPresetPanel.bottom
          anchors.bottom: healingBottomPanel.top
          margin-left: 8
          margin-top: 7

          Label
            text: Spell Healing
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.top
            color: #e5e5e5

          HelperV2HealingSlot
            id: spellSlot1
            anchors.left: parent.left
            anchors.top: prev.bottom
            margin-top: 7

          HelperV2HealingSlot
            id: spellSlot2
            anchors.left: parent.left
            anchors.top: prev.bottom

          HelperV2HealingSlot
            id: spellSlot3
            anchors.left: parent.left
            anchors.top: prev.bottom

        UIWidget
          id: potionHealingColumn
          width: 186
          anchors.right: parent.right
          anchors.top: spellHealingColumn.top
          anchors.bottom: healingBottomPanel.top
          margin-right: 8

          Label
            text: Potion Healing
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.top
            color: #e5e5e5

          HelperV2HealingSlot
            id: potionSlot1
            anchors.left: parent.left
            anchors.top: prev.bottom
            margin-top: 7

          HelperV2HealingSlot
            id: potionSlot2
            anchors.left: parent.left
            anchors.top: prev.bottom

          HelperV2HealingSlot
            id: potionSlot3
            anchors.left: parent.left
            anchors.top: prev.bottom

        UIWidget
          id: healingBottomPanel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          height: 76
          margin-left: 10
          margin-right: 10
          margin-bottom: 8

          HorizontalSeparator
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top

          QtCheckBox
            id: v2HealingEnabledBox
            text: Enable Healing Helper
            anchors.left: parent.left
            anchors.top: parent.top
            margin-top: 15
            size: 165 16
            text-offset: 18 0

          SmallButton
            text: Set Hotkey
            size: 72 20
            anchors.left: prev.right
            anchors.verticalCenter: prev.verticalCenter
            margin-left: 8

          Label
            text: Healing V2 - spell slots enabled
            anchors.left: parent.left
            anchors.bottom: parent.bottom
            color: #888888

      HelperV2Section
        id: toolsSection
        anchors.left: healingSection.right
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        margin-left: 7
        margin-right: 6

        Label
          text: Tools
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: parent.top
          margin-top: 6
          font: verdana-11px-antialised
          color: #dfdfdf

        QtCheckBox
          id: v2AutoReconnectBox
          text: Auto Reconnect
          anchors.left: parent.left
          anchors.top: parent.top
          margin-left: 22
          margin-top: 42
          size: 160 16
          text-offset: 18 0

        QtCheckBox
