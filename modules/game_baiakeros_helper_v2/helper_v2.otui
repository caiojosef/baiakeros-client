            anchors.left: parent.left
            anchors.top: parent.top
            margin-left: 15
            margin-top: 6
            color: #cfcfcf

          Label
            id: v2StanceTitle
            text: Stance
            anchors.left: parent.left
            anchors.top: parent.top
            margin-left: 155
            margin-top: 2
            color: #aaaaaa

          HelperV2PostureButton
            id: v2StanceButton1
            anchors.left: v2StanceTitle.left
            anchors.top: v2StanceTitle.bottom
            margin-top: 2
            visible: false

          HelperV2PostureButton
            id: v2StanceButton2
            anchors.left: v2StanceButton1.right
            anchors.top: v2StanceButton1.top
            margin-left: 7
            visible: false

          HelperV2PostureButton
            id: v2StanceButton3
            anchors.left: v2StanceButton2.right
            anchors.top: v2StanceButton2.top
            margin-left: 7
            visible: false

          Label
            id: v2PassiveTitle
            text: Passive
            anchors.left: parent.left
            anchors.top: v2StanceTitle.top
            margin-left: 380
            color: #aaaaaa

          HelperV2PostureButton
            id: v2PassiveButton1
            anchors.left: v2PassiveTitle.left
            anchors.top: v2StanceButton1.top
            visible: false

          HelperV2PostureButton
            id: v2PassiveButton2
            anchors.left: v2PassiveButton1.right
            anchors.top: v2PassiveButton1.top
            margin-left: 7
            visible: false

        HorizontalSeparator
          id: v2CombatStyleSeparator
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: v2CombatStyleBlock.bottom
          margin-left: 10
          margin-right: 10
          margin-top: 1

        Label
          id: v2SpellColumnLabel
          text: Spell
          anchors.left: parent.left
          anchors.top: v2CombatStyleSeparator.bottom
          margin-left: 16
          margin-top: 5
          color: #aaaaaa

        Label
          text: Mana %
          anchors.left: parent.left
          anchors.verticalCenter: prev.verticalCenter
          margin-left: 79
          color: #aaaaaa

        Label
          text: Creatures
          anchors.left: parent.left
          anchors.verticalCenter: prev.verticalCenter
          margin-left: 162
          color: #aaaaaa

        Label
          text: Priority
          anchors.left: parent.left
          anchors.verticalCenter: prev.verticalCenter
          margin-left: 238
          color: #aaaaaa

        UIWidget
          id: v2SpellRows
          anchors.left: parent.left
          anchors.right: v2RuneBlock.left
          anchors.top: prev.bottom
