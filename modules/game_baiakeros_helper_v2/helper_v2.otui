HelperV2HealingStepButton < UIButton
  color: #cfcfcf
  image-source: /images/ui/button
  image-clip: 0 0 22 23
  image-border: 3
  text-offset: 0 0
  font: verdana-11px-antialised

  $hover:
    color: #ffffff

  $pressed:
    color: #ffffff
    image-clip: 0 46 22 23
    text-offset: 1 1

  $disabled:
    color: #555555
    opacity: 0.65

HelperV2HealingEmptySlot < UIWidget
  size: 26 8
  background-color: #252727
  phantom: true

  UIWidget
    size: 5 5
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 1
    background-color: #303232
    border-width: 1
    border-color: #424444

  UIWidget
    size: 5 5
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 1
    background-color: #303232
    border-width: 1
    border-color: #424444

  UIWidget
    size: 5 5
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 1
    background-color: #303232
    border-width: 1
    border-color: #424444

  UIWidget
    size: 5 5
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 1
    background-color: #303232
    border-width: 1
    border-color: #424444

HelperV2HealingValuePanel < UIWidget
  background-color: #0b0b0b5c
  border-width: 1
  border-color: #4c4c4c
  font: verdana-11px-antialised

HelperV2HealingSlot < UIWidget
  size: 176 42

  UIButton
    id: assignButton
    size: 38 38
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 18
    image-source: /images/game/actionbar/actionbarslot
    text: ''
    font: verdana-11px-antialised

    HelperV2HealingEmptySlot
      id: emptyDecoration
      anchors.centerIn: parent

  UIWidget
    id: spellIcon
    anchors.fill: assignButton
    visible: false
    phantom: true

  UIItem
    id: itemIcon
    anchors.fill: assignButton
    visible: false
    virtual: true
    phantom: true

  Label
    id: assignedName
    visible: false

  HelperV2HealingStepButton
    id: decreaseButton
    text: <
    size: 18 26
    anchors.left: assignButton.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8

  HelperV2HealingValuePanel
    id: thresholdPanel
    size: 52 26
    anchors.left: decreaseButton.right
    anchors.verticalCenter: parent.verticalCenter

    Label
      id: thresholdLabel
      text: 90%
      anchors.fill: parent
      text-align: center
      color: #eeeeee
      font: verdana-11px-antialised

  HelperV2HealingStepButton
    id: increaseButton
    text: >
    size: 18 26
    anchors.left: thresholdPanel.right
    anchors.verticalCenter: parent.verticalCenter

  UIButton
    id: resourceButton
    text: H
    size: 16 16
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 0
    text-align: center
    color: #ed6464
    border-width: 1
    border-color: #b83c3c
    visible: false
    !tooltip: tr('Hybrid potion resource.')
HelperV2Section < UIWidget
  image-source: /images/ui/window
  image-border: 6
  image-border-top: 27

HelperV2AttackRow < UIWidget
