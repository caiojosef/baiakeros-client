HelperV2TabButton < UIButton
  image-source: /images/ui/button
  image-clip: 0 0 22 23
  image-border: 3
  font: verdana-11px-antialised
  color: #dfdfdf
  text-offset: 18 0

  $hover:
    color: #ffffff

  $on:
    color: #f0d48a

  $pressed:
    image-clip: 0 46 22 23

HelperV2Section < UIWidget
  image-source: /images/ui/window
  image-border: 6
  image-border-top: 27

HelperV2AttackValuePanel < UIWidget
  background-color: #0b0b0b5c
  border-width: 1
  border-color: #4c4c4c

HelperV2WaypointRow < UIButton
  height: 22
  text-align: left
  font: verdana-11px-antialised
  color: #ffffff

  SmallButton
    id: removeWaypoint
    text: X
    color: #ffffff
    size: 20 18
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 24
    !tooltip: tr('Delete this waypoint.')

  $hover:
    background-color: #ffffff0d

  $on:
    background-color: #426f9938
    border-width: 1
    border-color: #527da3

HelperV2PostureButton < UIButton
  size: 38 38
  image-source: /images/game/actionbar/actionbarslot

  UIProgressRect
    id: cooldown
    background: #101010aa
    percent: 100
    focusable: false
    phantom: true
    anchors.fill: parent
    font: verdana-11px-rounded
    color: white
    border-color: #9fa0a0

  Panel
    id: activeSpell
    anchors.fill: parent
    margin: 1 1 1 1
    image-source: /images/game/actionbar/border_activespell
    phantom: true
    visible: false

HelperV2AttackRow < UIWidget
  height: 36
  background-color: #ffffff03

  UIButton
    id: assignButton
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    image-source: /images/game/actionbar/actionbarslot

  UIWidget
    id: spellIcon
    anchors.fill: assignButton
    visible: false
    phantom: true

  UIItem
    id: itemIcon
    anchors.fill: assignButton
    visible: false
    virtual: true
    phantom: true

  QtCheckBox
    id: allowMultipleBox
    size: 18 18
    anchors.left: assignButton.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    visible: false
    !tooltip: tr('Cast if have +1 creatures')

  HelperV2RegenStep
    id: manaDecrease
    text: <
    size: 14 24
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 70

  HelperV2AttackValuePanel
    id: manaPanel
    size: 46 24
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter

    Label
      id: manaLabel
      text: 0%
      anchors.fill: parent
      text-align: center
      color: #eeeeee

  HelperV2RegenStep
    id: manaIncrease
    text: >
    size: 14 24
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter

  HelperV2RegenStep
    id: enemiesDecrease
    text: <
    size: 14 24
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 153

  HelperV2AttackValuePanel
    id: enemiesPanel
    size: 36 24
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter

    Label
      id: enemiesLabel
      text: 1
      anchors.fill: parent
      text-align: center
      color: #eeeeee

  HelperV2RegenStep
    id: enemiesIncrease
    text: >
    size: 14 24
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter

  QtComboBox
    id: priorityBox
    size: 70 24
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 228
    mouse-scroll: false

HelperV2RuneRow < UIWidget
  height: 36

  UIButton
    id: assignButton
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    image-source: /images/game/actionbar/actionbarslot

  UIItem
    id: itemIcon
    anchors.fill: assignButton
    visible: false
    virtual: true
    phantom: true

  HelperV2RegenStep
    id: enemiesDecrease
    text: <
    size: 14 24
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 54

  HelperV2AttackValuePanel
    id: enemiesPanel
    size: 36 24
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter

    Label
      id: enemiesLabel
      text: 1
      anchors.fill: parent
      text-align: center
      color: #eeeeee

  HelperV2RegenStep
    id: enemiesIncrease
    text: >
    size: 14 24
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter

  QtComboBox
    id: priorityBox
    size: 70 24
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 130
    mouse-scroll: false

BaiakerosHelperV2Window < MainWindow
  id: baiakerosHelperV2Window
  !text: tr('Baiakeros Helper')
  size: 900 610
  anchors.centerIn: parent
  visible: false
  @onEscape: modules.game_baiakeros_helper_v2.hide()

  UIWidget
    id: navigationBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    height: 36
    background-color: #404040
    border-width-top: 1
    border-color-top: black
    border-width-left: 1
    border-color-left: black
    border-width-bottom: 1
    border-color-bottom: #747474
    border-width-right: 1
    border-color-right: #747474

    HelperV2TabButton
      id: healingToolsTab
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 1
      size: 162 36
      text: Healing & Tools
      !tooltip: tr('Healing & Tools')
      @onClick: modules.game_baiakeros_helper_v2.showHelperV2Tab('healing')

      UIWidget
        size: 24 24
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        image-source: /images/baiakeros/helper_v2_healing
        image-smooth: true
        phantom: true

    HelperV2TabButton
      id: attackTab
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 1
      size: 34 36
      text: ''
      !tooltip: tr('Attack')
      @onClick: modules.game_baiakeros_helper_v2.showHelperV2Tab('attack')

      UIWidget
        size: 24 24
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        image-source: /images/baiakeros/helper_v2_attack
        image-smooth: true
        phantom: true

    HelperV2TabButton
      id: equipmentTab
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 1
      size: 34 36
      text: ''
      !tooltip: tr('Amulets & Rings')
      @onClick: modules.game_baiakeros_helper_v2.showHelperV2Tab('equipment')

      UIWidget
        size: 24 24
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        image-source: /images/baiakeros/helper_v2_equipment
        image-smooth: true
        phantom: true

    HelperV2TabButton
      id: cavebotTab
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 1
      size: 34 36
      text: ''
      !tooltip: tr('Cavebot')
      @onClick: modules.game_baiakeros_helper_v2.showHelperV2Tab('cavebot')

      UIWidget
        size: 24 24
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        image-source: /images/baiakeros/helper_v2_cavebot
        image-smooth: true
        phantom: true
    HelperV2TabButton
      id: partyHuntTab
      visible: false
      enabled: false
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 1
      size: 34 36
      text: ''
      !tooltip: tr('Party Hunt')
      @onClick: modules.game_baiakeros_helper_v2.showHelperV2Tab('party')

      UIWidget
        size: 24 24
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        image-source: /images/icons/icon-partyhunt-widget
        image-smooth: true
        phantom: true

  UIWidget
    id: contentContainer
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: navigationBar.bottom
    anchors.bottom: bottomSeparator.top
    margin-top: 7
    margin-bottom: 7

    UIWidget
      id: equipmentPage
      anchors.fill: parent
      visible: false

    UIWidget
      id: partyHuntPage
      anchors.fill: parent
      visible: false

    UIWidget
      id: healingToolsPage
      anchors.fill: parent

      HelperV2HealingPanel
        id: healingSection
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 6

      HelperV2SioPanel
        id: v2SioPanel
        anchors.left: healingSection.left
        anchors.right: healingSection.right
        anchors.top: healingSection.bottom
        anchors.bottom: parent.bottom
        margin-top: 7

      HelperV2Section
        id: toolsSection
        anchors.left: healingSection.right
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        margin-left: 7
        margin-right: 6

        Label
          text: Tools
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: parent.top
          margin-top: 6
          font: verdana-11px-antialised
          color: #dfdfdf

        Label
          id: v2AutoHasteLabel
          text: Auto Haste
          anchors.left: parent.left
          anchors.top: parent.top
          margin-left: 22
          margin-top: 39
          color: #dcdcdc

        UIButton
          id: v2AutoHasteSpellSlot
          size: 40 40
          anchors.left: v2AutoHasteLabel.left
          anchors.top: v2AutoHasteLabel.bottom
          margin-top: 7
          image-source: /images/game/actionbar/actionbarslot

        QtCheckBox
          id: v2AutoHasteInPzBox
          text: Cast in PZ
          size: 120 18
          anchors.left: v2AutoHasteSpellSlot.right
          anchors.top: v2AutoHasteSpellSlot.top
          margin-left: 10
          text-offset: 18 0
          !tooltip: tr('Allow Auto Haste inside a Protection Zone.')

        QtComboBox
          id: v2AutoHasteModeBox
          size: 108 22
          anchors.left: v2AutoHasteInPzBox.left
          anchors.top: v2AutoHasteInPzBox.bottom
          margin-top: 2
          mouse-scroll: false

        UIWidget
          id: v2AutoHasteSpellIcon
          anchors.fill: v2AutoHasteSpellSlot
          visible: false
          phantom: true

        HorizontalSeparator
          id: v2HasteSeparator
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: v2AutoHasteSpellSlot.bottom
          margin-left: 12
          margin-right: 12
          margin-top: 18

        Label
          id: v2TrainingTitle
          text: Training
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: v2HasteSeparator.bottom
          margin-top: 11
          color: #f0d48a

        Label
          text: Exercise Weapon
          anchors.left: parent.left
          anchors.top: v2TrainingTitle.bottom
          margin-left: 22
          margin-top: 6
          color: #dcdcdc

        UIButton
          id: v2ExerciseWeaponSlot
          size: 40 40
          anchors.left: prev.left
          anchors.top: prev.bottom
          margin-top: 4
          image-source: /images/game/actionbar/actionbarslot

        UIItem
          id: v2ExerciseWeaponIcon
          anchors.fill: v2ExerciseWeaponSlot
          visible: false
          virtual: true

        QtComboBox
          id: v2ExerciseModeBox
          size: 100 22
          anchors.left: v2ExerciseWeaponSlot.right
          anchors.verticalCenter: v2ExerciseWeaponSlot.verticalCenter
          margin-left: 9
          mouse-scroll: false

        Label
          text: Mana Training
          anchors.left: v2ExerciseWeaponSlot.left
          anchors.top: v2ExerciseWeaponSlot.bottom
          margin-top: 7
          color: #dcdcdc

        UIButton
          id: v2ManaTrainingSlot
          size: 40 40
          anchors.left: prev.left
          anchors.top: prev.bottom
          margin-top: 4
          image-source: /images/game/actionbar/actionbarslot

        UIWidget
          id: v2ManaTrainingIcon
          anchors.fill: v2ManaTrainingSlot
          visible: false

        HelperV2RegenStep
          id: v2ManaTrainingDecrease
          text: <
          size: 18 26
          anchors.left: v2ManaTrainingSlot.right
          anchors.verticalCenter: v2ManaTrainingSlot.verticalCenter
          margin-left: 8

        UIWidget
          size: 52 26
          anchors.left: prev.right
          anchors.verticalCenter: prev.verticalCenter
          background-color: #0b0b0b5c
          border-width: 1
          border-color: #4c4c4c

          Label
            id: v2ManaTrainingPercentLabel
            text: 90%
            anchors.fill: parent
            text-align: center
            color: #eeeeee
            font: verdana-11px-antialised

        HelperV2RegenStep
          id: v2ManaTrainingIncrease
          text: >
          size: 18 26
          anchors.left: prev.right
          anchors.verticalCenter: prev.verticalCenter

        QtCheckBox
          id: v2ManaTrainingEnabledBox
          size: 18 18
          anchors.left: prev.right
          anchors.verticalCenter: prev.verticalCenter
          margin-left: 7

        HorizontalSeparator
          id: v2TrainingSeparator
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: v2ManaTrainingSlot.bottom
          margin-left: 12
          margin-right: 12
          margin-top: 14

        QtCheckBox
          id: v2AutoReconnectBox
          text: Auto Reconnect
          anchors.left: v2AutoHasteSpellSlot.left
          anchors.top: v2TrainingSeparator.bottom
          margin-top: 12
          size: 160 16
          text-offset: 18 0

        QtCheckBox
          id: v2AutoEatFoodBox
          text: Auto Eat Food
          anchors.left: prev.left
          anchors.top: prev.bottom
          margin-top: 14
          size: 160 16
          text-offset: 18 0

        QtCheckBox
          id: v2ChangeGoldBox
          text: Change Gold
          anchors.left: v2AutoReconnectBox.left
          anchors.top: v2AutoEatFoodBox.bottom
          margin-top: 14
          size: 160 16
          text-offset: 18 0

        QtCheckBox
          id: v2FlaskRemoverBox
          text: Flask Remover
          anchors.left: prev.left
          anchors.top: prev.bottom
          margin-top: 14
          size: 160 16
          text-offset: 18 0

        QtCheckBox
          id: v2AutolootBox
          text: Autoloot
          anchors.left: prev.left
          anchors.top: prev.bottom
          margin-top: 14
          size: 100 16
          text-offset: 18 0

        SmallButton
          text: Store
          id: v2LootPouchStoreButton
          size: 48 18
          anchors.left: prev.right
          anchors.verticalCenter: prev.verticalCenter
          margin-left: 7

    UIWidget
      id: attackPage
      anchors.fill: parent
      visible: false

      HelperV2Section
        id: attackConfiguration
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        height: 345
        margin-left: 6
        margin-right: 7

        Label
          text: Spell & Rune Shooter Helper
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: parent.top
          margin-top: 6
          color: #dfdfdf

        Label
          id: v2AttackPresetLabel
          text: Attack Preset
          anchors.left: parent.left
          anchors.top: parent.top
          margin-left: 15
          margin-top: 30
          color: #cfcfcf

        QtComboBox
          id: v2AttackPresetBox
          size: 110 22
          anchors.left: v2AttackPresetLabel.right
          anchors.verticalCenter: v2AttackPresetLabel.verticalCenter
          margin-left: 7
          mouse-scroll: false

        QtButton
          id: v2AttackPresetAddButton
          text: +
          size: 22 20
          anchors.left: v2AttackPresetBox.right
          anchors.verticalCenter: v2AttackPresetBox.verticalCenter
          margin-left: 5
          !tooltip: tr('Create a new Attack preset.')

        QtButton
          id: v2AttackPresetDeleteButton
          text: x
          size: 22 20
          anchors.left: v2AttackPresetAddButton.right
          anchors.verticalCenter: v2AttackPresetAddButton.verticalCenter
          margin-left: 4
          !tooltip: tr('Delete the selected Attack preset.')

        QtButton
          id: v2AttackPresetHotkeyButton
          text: Set Hotkey
          size: 64 20
          anchors.left: v2AttackPresetDeleteButton.right
          anchors.verticalCenter: v2AttackPresetDeleteButton.verticalCenter
          margin-left: 5

        HorizontalSeparator
          id: v2AttackPresetSeparator
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: v2AttackPresetBox.bottom
          margin-left: 10
          margin-right: 10
          margin-top: 6

        UIWidget
          id: v2CombatStyleBlock
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: v2AttackPresetSeparator.bottom
