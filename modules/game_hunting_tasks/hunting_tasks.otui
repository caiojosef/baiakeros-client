TaskFilterButton < UIButton
  height: 27
  font: verdana-11px-antialised
  color: #c7c7c7
  image-source: /images/ui/button
  image-border: 3
  text-align: left
  text-offset: 10 0

  $hover:
    color: #ffffff
    background-color: #ffffff12

  $on:
    color: #f0d48a
    border-width: 1
    border-color: #c2a15c
    background-color: #a7833030

TaskCreature < UICreature
  size: 58 58
  image-source: /images/ui/item
  image-border: 1
  padding: 4
  phantom: true

TaskCard < UIWidget
  height: 184
  image-source: /images/ui/window_headless
  image-border: 5
  margin-bottom: 7
  padding: 8

  Label
    id: titleLabel
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.right: difficultyLabel.left
    margin-left: 8
    margin-top: 7
    font: verdana-11px-antialised
    color: #f0d48a

  Label
    id: difficultyLabel
    anchors.right: parent.right
    anchors.top: parent.top
    margin-right: 8
    margin-top: 7
    width: 100
    text-align: right
    color: #bdbdbd

  UIWidget
    id: creaturePanel
    anchors.left: parent.left
    anchors.top: titleLabel.bottom
    size: 190 64
    margin-left: 8
    margin-top: 6

    TaskCreature
      id: creature1
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter

    TaskCreature
      id: creature2
      anchors.left: creature1.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5

    TaskCreature
      id: creature3
      anchors.left: creature2.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5

  Label
    id: monstersLabel
    anchors.left: creaturePanel.right
    anchors.right: parent.right
    anchors.top: creaturePanel.top
    height: 58
    margin-left: 8
    margin-right: 8
    text-wrap: true
    color: #d0d0d0

  Label
    id: rewardLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: creaturePanel.bottom
    margin-left: 8
    margin-right: 8
    margin-top: 4
    height: 36
    text-wrap: true
    color: #9fd48d

  ProgressBar
    id: progressBar
    anchors.left: parent.left
    anchors.right: actionButton.left
    anchors.bottom: parent.bottom
    height: 20
    margin-left: 8
    margin-right: 8
    margin-bottom: 8

  QtButton
    id: actionButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 92 20
    margin-right: 8
    margin-bottom: 8

TaskHistoryCard < UIWidget
  height: 62
  image-source: /images/ui/window_headless
  image-border: 5
  margin-bottom: 6

  Label
    id: titleLabel
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.right: parent.right
    margin-left: 10
    margin-right: 10
    margin-top: 9
    color: #f0d48a

  Label
    id: rewardLabel
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    anchors.right: dateLabel.left
    margin-left: 10
    margin-bottom: 9
    color: #9fd48d

  Label
    id: dateLabel
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 140
    margin-right: 10
    margin-bottom: 9
    text-align: right
    color: #a8a8a8

TaskRankingCard < UIWidget
  height: 58
  image-source: /images/ui/window_headless
  image-border: 5
  margin-bottom: 6

  Label
    id: positionLabel
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 50
    margin-left: 10
    text-align: center
    font: verdana-11px-antialised
    color: #f0d48a

  Label
    id: playerLabel
    anchors.left: positionLabel.right
    anchors.right: completedLabel.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    margin-right: 8
    color: #ffffff

  Label
    id: completedLabel
    anchors.right: linesLabel.left
    anchors.verticalCenter: parent.verticalCenter
    width: 145
    margin-right: 8
    text-align: right
    color: #9fd48d

  Label
    id: linesLabel
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    width: 110
    margin-right: 10
    text-align: right
    color: #a8a8a8

TaskRewardChoiceButton < QtButton
  size: 122 52

  UIWidget
    id: choiceIcon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 32 32
    margin-left: 7
    phantom: true

  UIItem
    id: choiceItem
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 32 32
    margin-left: 7
    visible: false
    virtual: true
    phantom: true

  Label
    id: choiceLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 44
    margin-right: 5
    text-align: center
    text-wrap: true
    color: #c0c0c0
    phantom: true

HuntingTasksWindow < MainWindow
  id: huntingTasksWindow
  !text: tr('Hunting Tasks')
  size: 720 550
  anchors.centerIn: parent
  visible: false
  @onEscape: modules.game_hunting_tasks.hide()

  UIWidget
    id: filterPanel
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 145
    margin-left: 7
    margin-top: 7
    margin-bottom: 38
    image-source: /images/ui/window_headless
    image-border: 5
    padding: 7

    Label
      text: Categories
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      margin-left: 7
      margin-right: 7
      margin-top: 7
      text-align: center
      font: verdana-11px-antialised
      color: #f0d48a

    TaskFilterButton
      id: availableFilter
      text: Available
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-left: 6
      margin-right: 6
      margin-top: 12

    TaskFilterButton
      id: progressFilter
      text: In Progress
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-left: 6
      margin-right: 6
      margin-top: 4

    TaskFilterButton
      id: completedFilter
      text: Completed
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-left: 6
      margin-right: 6
      margin-top: 4

    TaskFilterButton
      id: historyFilter
      text: History
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-left: 6
      margin-right: 6
      margin-top: 4

    TaskFilterButton
      id: rankingFilter
      text: Ranking
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-left: 6
      margin-right: 6
      margin-top: 4

    HorizontalSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-left: 6
      margin-right: 6
      margin-top: 10

    Label
      id: activeSummary
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      height: 90
      margin-left: 7
      margin-right: 7
      margin-top: 9
      text-wrap: true
      color: #bdbdbd

  UIWidget
    id: contentPanel
    anchors.left: filterPanel.right
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 8
    margin-right: 8
    margin-top: 7
    margin-bottom: 38
    image-source: /images/ui/window_headless
    image-border: 5

    Label
      id: sectionTitle
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      height: 24
      margin-left: 10
      margin-right: 10
      margin-top: 7
      text-align: center
      font: verdana-11px-antialised
      color: #f0d48a

    UIScrollArea
      id: taskList
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: sectionTitle.bottom
      anchors.bottom: parent.bottom
      margin-left: 8
      margin-right: 6
      margin-top: 4
      margin-bottom: 8
      padding-right: 16
      vertical-scrollbar: taskScrollBar
      layout:
        type: verticalBox

    VerticalScrollBar
      id: taskScrollBar
      anchors.top: sectionTitle.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      step: 50
      pixel-scroll: true
      margin-top: 4
      margin-bottom: 8
      margin-right: 6

  Label
    id: statusLabel
    anchors.left: parent.left
    anchors.right: closeButton.left
    anchors.bottom: parent.bottom
    margin-left: 12
    margin-right: 10
    margin-bottom: 10
    color: #a8a8a8

  QtButton
    id: closeButton
    text: Close
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 64 20
    margin-right: 10
    margin-bottom: 8
    @onClick: modules.game_hunting_tasks.hide()
