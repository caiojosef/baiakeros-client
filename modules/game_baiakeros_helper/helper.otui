HelperPercentComboBox < QtComboBox

HelperFriendSlot < UIWidget
  height: 40

  QtButton
    id: addButton
    text: +
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter

  UICreature
    id: outfit
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    visible: false
    phantom: true

  Label
    id: nameLabel
    text: Empty
    visible: false
