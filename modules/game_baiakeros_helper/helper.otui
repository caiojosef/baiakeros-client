  QtCheckBox
    id: enableBox
    size: 18 18
    anchors.left: clearButton.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    visible: false
    !tooltip: tr('Enable or disable healing for this party member.')

  HelperPercentComboBox
    id: thresholdBox
    size: 62 24
    anchors.left: outfit.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    mouse-scroll: false
    menu-scroll: true
    menu-height: 190
    menu-scroll-step: 20
    text-align: center
    font: verdana-11px-antialised
    visible: false

  QtButton
    id: clearButton
    text: x
    size: 18 24
    anchors.left: thresholdBox.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    visible: false

HelperPostureButton < UIButton
