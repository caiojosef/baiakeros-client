BaiakerosHelperWindow < MainWindow
  id: baiakerosHelperWindow
  !text: tr('BaiakEros Helper V1 - View Only')
  size: 430 520
  anchors.centerIn: parent
  visible: false
  @onEscape: modules.game_baiakeros_helper.hide()

  UIWidget
    id: tabBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    height: 42

    HelperTabButton
      id: healingTabButton
      width: 124
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 6
      margin-top: 1
      @onClick: modules.game_baiakeros_helper.showHelperTab('healing')

      UIWidget
        id: tabIcon
        size: 30 30
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        image-source: /images/baiakeros/helper-tab-healing
        image-fixed-ratio: true
        image-smooth: true
        phantom: true

      Label
        id: tabLabel
        text: Healing
        anchors.left: tabIcon.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 7
        font: verdana-11px-antialised
        color: #f0d48a
        phantom: true

    HelperTabButton
      id: attackTabButton
      width: 124
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: healingTabButton.top
      @onClick: modules.game_baiakeros_helper.showHelperTab('attack')

      UIWidget
        id: tabIcon
        size: 30 30
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        image-source: /images/baiakeros/helper-tab-attack
        image-fixed-ratio: true
        image-smooth: true
        phantom: true

      Label
        id: tabLabel
        text: Attack
        anchors.left: tabIcon.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 7
        font: verdana-11px-antialised
        color: #f0d48a
        phantom: true

    HelperTabButton
      id: extrasTabButton
      width: 124
      anchors.right: parent.right
      anchors.top: attackTabButton.top
      margin-right: 6
      @onClick: modules.game_baiakeros_helper.showHelperTab('extras')

      UIWidget
        id: tabIcon
        size: 30 30
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        image-source: /images/baiakeros/helper-tab-extras
        image-fixed-ratio: true
        image-smooth: true
        phantom: true

      Label
        id: tabLabel
        text: Extras
        anchors.left: tabIcon.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 7
        font: verdana-11px-antialised
        color: #f0d48a
        phantom: true

  UIWidget
    id: helperPresetPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: tabBar.bottom
    height: 30

    UIWidget
      id: helperPresetControls
      size: 249 22
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter

      Label
        text: Preset
        width: 42
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        color: #cfcfcf

      QtComboBox
        id: helperPresetBox
        size: 86 22
        anchors.left: prev.right
        anchors.verticalCenter: prev.verticalCenter
        margin-left: 5
        mouse-scroll: false

      QtButton
        text: +
        size: 22 20
        anchors.left: prev.right
        anchors.verticalCenter: prev.verticalCenter
        margin-left: 5
        !tooltip: tr('Create a new Helper preset.')
        @onClick: modules.game_baiakeros_helper.openPresetNameWindow('helper')

      QtButton
        text: x
        size: 22 20
        anchors.left: prev.right
        anchors.verticalCenter: prev.verticalCenter
        margin-left: 4
        !tooltip: tr('Delete the selected Helper preset.')
        @onClick: modules.game_baiakeros_helper.requestDeletePreset('helper')

      HelperHotkeyButton
        text: Set Hotkey
        size: 58 20
        anchors.left: prev.right
        anchors.verticalCenter: prev.verticalCenter
        margin-left: 5
        @onClick: modules.game_baiakeros_helper.setHelperHotkey('Next Helper Preset')

  UIWidget
    id: attackPresetPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: tabBar.bottom
    height: 30
    visible: false

    UIWidget
      id: attackPresetControls
      size: 273 22
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter

      Label
        text: Spell Preset
        width: 70
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        color: #cfcfcf

      QtComboBox
        id: attackPresetBox
        size: 82 22
        anchors.left: prev.right
        anchors.verticalCenter: prev.verticalCenter
        margin-left: 5
        mouse-scroll: false

      QtButton
        text: +
        size: 22 20
        anchors.left: prev.right
        anchors.verticalCenter: prev.verticalCenter
        margin-left: 5
        !tooltip: tr('Create a new Attack preset.')
        @onClick: modules.game_baiakeros_helper.openPresetNameWindow('attack')

      QtButton
        text: x
        size: 22 20
        anchors.left: prev.right
        anchors.verticalCenter: prev.verticalCenter
        margin-left: 4
        !tooltip: tr('Delete the selected Attack preset.')
        @onClick: modules.game_baiakeros_helper.requestDeletePreset('attack')

      HelperHotkeyButton
        text: Set Hotkey
        size: 58 20
        anchors.left: prev.right
        anchors.verticalCenter: prev.verticalCenter
        margin-left: 5
        @onClick: modules.game_baiakeros_helper.setHelperHotkey('Next Attack Preset')

  UIWidget
    id: healingPage
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: helperPresetPanel.bottom
    anchors.bottom: footerSeparator.top
    margin-top: 0
    margin-bottom: 6

    QtPanel
      id: characterPanel
      anchors.left: parent.left
      anchors.top: parent.top
      width: 205
      height: 335
      visible: false

      Label
        id: characterNameLabel
        text: Character
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        margin-top: 12
        text-align: center
        font: verdana-11px-antialised
        color: #e0e0e0

      UICreature
        id: outfitPreview
        size: 82 82
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: characterNameLabel.bottom
        margin-top: 8

      Label
        id: vocationLabel
        text: Vocation
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: outfitPreview.bottom
        margin-top: 8
        text-align: center
        color: #f0d48a

      Label
        text: Preset: Default
        anchors.left: parent.left
        anchors.top: vocationLabel.bottom
        margin-left: 18
        margin-top: 20
        color: #d0d0d0

      QtCheckBox
        id: hiddenHealingEnabledBox
        text: Helper enabled
        size: 170 20
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-left: 18
        margin-top: 13
        @onCheckChange: modules.game_baiakeros_helper.setHealingEnabled(self:isChecked())

      Label
        text: The Helper keeps running when this window is closed.
        height: 42
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 18
        margin-right: 14
        margin-bottom: 16
        text-wrap: true
        color: #999999

    HelperTitledSectionPanel
      id: configurationPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      height: 340
      margin-left: 6
      margin-right: 6
      margin-top: 0

      Label
        id: healingSectionTitle
        text: Auto Healing Helper
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        margin-top: 7
        font: verdana-11px-antialised
        color: #dfdfdf

      UIWidget
        id: spellColumn
        width: 176
        anchors.left: parent.left
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        margin-left: 9

        Label
          text: Spell Healing
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: parent.top
          margin-top: 29
          font: verdana-11px-antialised
          color: #e5e5e5

        HelperAutoSlot
          id: spellSlot1
          anchors.left: parent.left
          anchors.top: prev.bottom
          margin-top: 5

        HelperAutoSlot
          id: spellSlot2
          anchors.left: parent.left
          anchors.top: prev.bottom
          margin-top: 1

        HelperAutoSlot
          id: spellSlot3
          anchors.left: parent.left
          anchors.top: prev.bottom
          margin-top: 1

        Label
          text: Right-click a slot and choose Assign Spell.
          height: 34
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: prev.bottom
          margin-top: 14
          margin-right: 8
          text-wrap: true
          color: #999999
          visible: false

      VerticalSeparator
        anchors.left: spellColumn.right
        anchors.top: parent.top
        height: 144
        margin-top: 35
        visible: false

      UIWidget
        id: potionColumn
        width: 176
        anchors.left: prev.right
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        margin-left: 8

        Label
          text: Potion Healing
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: parent.top
          margin-top: 29
          font: verdana-11px-antialised
          color: #e5e5e5

        HelperAutoSlot
          id: potionSlot1
          anchors.left: parent.left
          anchors.top: prev.bottom
