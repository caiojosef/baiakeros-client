        HelperAutoSlot
          id: potionSlot2
          anchors.left: parent.left
          anchors.top: prev.bottom
          margin-top: 1

        HelperAutoSlot
          id: potionSlot3
          anchors.left: parent.left
          anchors.top: prev.bottom
          margin-top: 1

      HorizontalSeparator
        id: healingControlSeparator
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: healingEnabledBox.top
        margin-left: 8
        margin-right: 8
        margin-bottom: 5

      QtCheckBox
        id: healingEnabledBox
        text: Enable Healing Helper
        size: 138 14
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        margin-left: -36
        margin-bottom: 10
        text-offset: 18 0
        @onCheckChange: modules.game_baiakeros_helper.setHealingEnabled(self:isChecked())

      HelperHotkeyButton
        id: healingHotkeyButton
        text: Set Hotkey
        size: 64 20
