HelperTabButton < UIButton
  size: 124 40
  font: verdana-11px-antialised
  color: #bdbdbd
  image-source: /images/ui/2pixel_up_frame_borderimage_dark
  image-border: 3

  $hover:
    color: #ffffff
    background-color: #ffffff12

  $on:
    color: #f0d48a
    background-color: #a7833030
    border-width: 1
    border-color: #c2a15c

HelperSectionPanel < UIWidget
  image-source: /images/ui/window_headless
  image-border: 5

HelperTitledSectionPanel < HelperSectionPanel
  image-source: /images/ui/window
  image-border: 6
  image-border-top: 27

HelperStepButton < UIButton
  color: #cfcfcf
  image-source: /images/ui/button
  image-clip: 0 0 22 23
  image-border: 3
  text-offset: 0 0
  font: verdana-11px-antialised

  $hover:
    color: #ffffff

  $pressed:
    color: #ffffff
    image-clip: 0 46 22 23
    text-offset: 1 1

  $disabled:
    color: #555555
    opacity: 0.65

HelperHotkeyButton < SmallButton
  color: #ffffff
  font: cipsoftFont
  text-align: center

  $hover !disabled:
    color: #ffffff

  $disabled:
    color: #ffffff88

HelperEmptySlotDecoration < UIWidget
  size: 26 8
  background-color: #252727
  phantom: true

  UIWidget
    size: 5 5
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 1
    background-color: #303232
    border-width: 1
    border-color: #424444

  UIWidget
    size: 5 5
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 1
    background-color: #303232
    border-width: 1
    border-color: #424444

  UIWidget
    size: 5 5
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 1
    background-color: #303232
    border-width: 1
    border-color: #424444

  UIWidget
    size: 5 5
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 1
    background-color: #303232
    border-width: 1
    border-color: #424444

HelperToggleNotification < Label
  size: 370 36
  anchors.centerIn: parent
  margin-top: -45
  text-align: center
  font: verdana-11px-antialised
  color: #79ef8b
  background-color: #111111dd
  border-width: 1
  border-color: #3f934d
  padding: 8
  visible: false
  focusable: false
  phantom: true

HelperPresetNameWindow < MainWindow
  size: 310 164
  text: New Preset
  @onEnter: modules.game_baiakeros_helper.createPresetFromWindow()
  @onEscape: modules.game_baiakeros_helper.closePresetNameWindow()

  Label
    id: infoLabel
    text: Use 1-10 letters or numbers:
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 12
    margin-right: 12
    margin-top: 14
    color: #dddddd

  TextEdit
    id: nameEdit
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: infoLabel.bottom
    height: 24
    margin-left: 12
    margin-right: 12
    margin-top: 8
    max-length: 10

  QtButton
    id: cancelButton
    text: Cancel
    size: 64 20
    anchors.right: parent.right
    anchors.top: nameEdit.bottom
    margin-right: 12
    margin-top: 18
    @onClick: modules.game_baiakeros_helper.closePresetNameWindow()

  QtButton
    id: createButton
    text: Create
    size: 64 20
    anchors.right: cancelButton.left
    anchors.top: cancelButton.top
    margin-right: 6
    @onClick: modules.game_baiakeros_helper.createPresetFromWindow()

HelperAttackValuePanel < UIWidget
  background-color: #0b0b0b5c
  border-width: 1
  border-color: #4c4c4c
  font: verdana-11px-antialised

HelperAutoSlot < UIWidget
  size: 176 42

  UIButton
    id: assignButton
    size: 38 38
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 18
    image-source: /images/game/actionbar/actionbarslot
    text: ''
    font: verdana-11px-antialised

    HelperEmptySlotDecoration
      id: emptyDecoration
      anchors.centerIn: parent

  UIWidget
    id: spellIcon
    anchors.fill: assignButton
    visible: false
    phantom: true

  UIItem
    id: itemIcon
    anchors.fill: assignButton
    visible: false
    virtual: true
    phantom: true

  Label
    id: assignedName
    visible: false

  HelperStepButton
    id: decreaseButton
    text: <
    size: 18 26
    anchors.left: assignButton.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8

  HelperAttackValuePanel
    id: thresholdPanel
    size: 52 26
    anchors.left: decreaseButton.right
    anchors.verticalCenter: parent.verticalCenter

    Label
      id: thresholdLabel
      text: 90%
      anchors.fill: parent
      text-align: center
      color: #eeeeee
      font: verdana-11px-antialised

  HelperStepButton
    id: increaseButton
    text: >
    size: 18 26
    anchors.left: thresholdPanel.right
    anchors.verticalCenter: parent.verticalCenter

  UIButton
    id: resourceButton
    text: H
    size: 16 16
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 0
    text-align: center
    color: #ed6464
    border-width: 1
    border-color: #b83c3c
    visible: false
    !tooltip: tr('Click to switch this hybrid potion between health and mana.')
    @onClick: modules.game_baiakeros_helper.togglePotionResource(self:getParent():getId())

HelperTrainingSlot < UIWidget
  size: 40 40

  UIButton
    id: assignButton
    size: 40 40
    anchors.left: parent.left
    anchors.top: parent.top
    image-source: /images/game/actionbar/actionbarslot
    text: ''
    !tooltip: tr('Right-click to select an exercise weapon.')

    HelperEmptySlotDecoration
      id: emptyDecoration
      anchors.centerIn: parent

    UIWidget
      id: selectedBackgroundMask
      size: 32 32
      anchors.centerIn: parent
      background-color: #1b1c1c
      visible: false
      phantom: true

  UIItem
    id: itemIcon
    anchors.fill: assignButton
    virtual: true
    phantom: true

  UIWidget
    id: spellIcon
    anchors.fill: assignButton
    visible: false
    phantom: true

HelperPartyMemberRow < UIButton
