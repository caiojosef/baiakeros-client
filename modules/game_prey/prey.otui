LockedPreyPanel < Panel
  size: 212 306

  NoCreaturePanel
    id: noCreature
    anchors.top: parent.top
    anchors.left: parent.left

  UIButton
    id: perm
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 64
    background-color: #1c4161
    margin-top: 3
    @onClick: modules.game_mainpanel.toggleStore()

    UIWidget
      id: shopPermButton
      anchors.fill: parent
      image-source: /images/ui/button-blue-qt
      image-clip: 0 0 98 40
      image-border: 1
      text: Unlock permanently
      font: verdana-bold_11
      text-align: center
      text-offset: 10 0
      @onClick: modules.game_mainpanel.toggleStore()
      @onHoverChange: modules.game_prey.onHover(self)

      UIWidget
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 13
        size: 12 12
        image-source: /images/store/icon-tibiacoin
        phantom: true

      $pressed:
        image-clip: 0 40 98 40
        text-offset: 11 1

  UIButton
    id: temp
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 64
    background-color: #1c4161
    margin-top: 7
    visible: false
    @onClick: modules.game_mainpanel.toggleStore()

    UIWidget
      id: shopTempButton
      anchors.fill: parent
      image-source: /images/ui/button-blue-qt
      image-clip: 0 0 98 40
      image-border: 1
      text: Unlock temporarily
      font: verdana-bold_11
      text-align: center
      text-offset: 10 0
      @onClick: modules.game_mainpanel.toggleStore()
      @onHoverChange: modules.game_prey.onHover(self)

      UIWidget
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 13
        size: 12 12
        image-source: /images/store/icon-tibiacoin
        phantom: true

      $pressed:
        image-clip: 0 40 98 40
        text-offset: 11 1

