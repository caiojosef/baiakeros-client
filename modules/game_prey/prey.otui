InactivePreyPanel < Panel
  size: 212 326

  ChoosePrey
    id: choose
    anchors.right: parent.right
    anchors.bottom: parent.bottom

  SelectPreyCreature
    id: select
    anchors.bottom: parent.bottom
    anchors.right: prev.left
    margin-right: 3

  RerollButton
    id: reroll
    anchors.bottom: parent.bottom
    anchors.right: prev.left
    margin-right: 3

  FlatPanel
    id: preview
    anchors.left: parent.left
    anchors.right: choose.left
    anchors.bottom: parent.bottom
    margin-right: 6
    height: 92
    padding: 4
    image-source: /images/ui/panel_flat
    image-border: 1
    visible: false

    Label
      id: placeholder
      anchors.centerIn: parent
      font: verdana-bold_11
      text-align: center
      !text: tr('No creature selected')
      color: #cfcfcf

    UICreature
      id: creature
      anchors.centerIn: parent
      size: 64 64
      phantom: true
      visible: false

  FlatPanel
    id: list
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 20
    padding: 1
    size: 195 195
    layout:
      type: grid
      cell-size: 64 64
      cell-spacing: 0
      num-columns: 3

  FlatPanel
    id: fullList
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: preview.top
    margin-top: 20
    margin-bottom: 8
    padding: 6
    visible: false
    image-source: /images/ui/panel_flat
    image-border: 1

    TextEdit
      id: searchEdit
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      height: 24
      font: verdana-bold_11
      padding-left: 4
      padding-right: 18
      placeholder: Type to search
      placeholder-color: #6e706f
      @onTextChange: modules.game_prey.onRaceSearchTextChanged(self)

    UIWidget
      id: searchClearButton
      anchors.top: searchEdit.top
      anchors.right: searchEdit.right
      margin-top: 2
      margin-right: 2
      size: 16 16
      image-source: /images/ui/button-clear-18x18-up
      visible: false
      @onClick: modules.game_prey.onRaceSearchClearClicked(self)

      $pressed:
        image-source: /images/ui/button-clear-18x18-down

    UIScrollArea
      id: entries
      anchors.top: searchEdit.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      margin-bottom: 6
      padding-left: 2
      padding-right: 14
      padding-bottom: 2
      vertical-scrollbar: entriesScroll
      layout:
        type: verticalBox

    VerticalScrollBar
      id: entriesScroll
      anchors.top: entries.top
      anchors.bottom: entries.bottom
      anchors.right: parent.right
      margin-right: 2
      step: 20
      pixel-scroll: true

