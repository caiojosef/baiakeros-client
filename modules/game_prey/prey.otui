MainWindow
  id: preyWindow
  text: Prey
  font: verdana-bold_11
  size: 744 574
  @onEscape: modules.game_prey.hide()
  padding: 20
  @onHoverChange: modules.game_prey.onHover(self)

  FlatPanel
    id: preyTabs
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    height: 34

    UIButton
      id: preyCreaturesTab
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 352
      checked: true
      text: Prey Creatures
      text-offset: 18 0
      font: verdana-bold_11
      image-source: /images/ui/button-grey-down
      image-border: 5

      UIWidget
        id: preyTabIcon
        size: 11 11
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 16
        image-source: /images/game/prey/icon-prey-widget
        image-smooth: false
        phantom: true

    UIButton
      id: huntingTasksTab
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      text: Hunting Tasks
      text-offset: 18 0
      font: verdana-bold_11
      tooltip: Hunting Tasks are available on supported game protocols.
      @onClick: modules.game_prey.openHuntingTasks()

      UIWidget
        id: huntingTasksTabIcon
        size: 20 20
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 10
        image-source: /images/options/button_taskboard
        image-clip: 0 0 20 20
        image-smooth: false
        phantom: true

  SlotPanel
    id: slot1
    anchors.left: parent.left
    anchors.top: preyTabs.bottom
    margin-top: 5

  SlotPanel
    id: slot2
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 11

  SlotPanel
    id: slot3
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 11

  FlatPanel
    id: descriptionBackground
    anchors.left: slot1.left
    anchors.top: slot1.bottom
    anchors.right: slot3.right
    anchors.bottom: bottomSep.top
    margin-bottom: 10
    margin-top: 10

  Label
    id: description
    anchors.fill: descriptionBackground
    margin: 8
    text-wrap: true
    text-align: topLeft
    text-offset: 0 0
    font: verdana-bold_11

  HorizontalSeparator
    id: bottomSep
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 10

  Button
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 60 24
    padding: 0
    text: Close
    text-offset: 0 0
    font: verdana-bold_11
    @onClick: modules.game_prey.hide()

  GoldLabel
    id: gold
    anchors.left: bottomSep.left
    anchors.verticalCenter: closeButton.verticalCenter
    size: 130 24
    margin: 0

  CardLabel
    id: wildCards
    anchors.left: prev.right
    margin-left: 8
    anchors.verticalCenter: closeButton.verticalCenter
    size: 80 24

  UIButton
    id: openStore
    anchors.left: prev.right
    margin-left: 8
    size: 26 20
    anchors.verticalCenter: closeButton.verticalCenter
    tooltip: Go to the Store to get more Prey Wildcards!
    image-source: /images/game/prey/prey_smallstore
    image-clip: 0 0 26 20
    background-color: #17354e
    @onClick: modules.game_mainpanel.toggleStore()

    $pressed:
      image-source: /images/game/prey/prey_smallstore_clicked
      image-clip: 0 0 26 20

