NPCOfferLabel < Label
  text-auto-resize: true
  color: #c0c0c0

NPCItemBox < UICheckBox
  border-width: 1
  border-color: #000000
  color: #c8c8c8
  text-align: left
  text-offset: 40 5
  font: verdana-11px-monochrome
  @onCheckChange: modules.game_npctrade.onItemBoxChecked(self)

  Item
    id: item
    phantom: true
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-color: #ffffffff
    margin-left: 4

  $checked on:
    border-color: #d8b13b

  $!checked:
    border-color: #000000

  $!on:
    image-color: #ffffff88
    color: #aaaaaa88

MiniWindow
  id: npcWindow
  !text: tr('NPC Trade')
  height: 360
  minimum-height: 240
  maximum-height: 620
  @onEscape: modules.game_npctrade.closeNpcTradeLegacy()
  @onClose: modules.game_npctrade.closeNpcTradeLegacy()

  MiniWindowContents
    id: contentsPanel
    padding: 3

    TabButton
      id: buyTab
      !tooltip: tr("List of items that you're able to buy")
      !text: tr('Buy')
      checked: true
      on: true
      anchors.left: parent.left
      anchors.right: parent.horizontalCenter
      anchors.top: parent.top
      margin-right: 2

    TabButton
      id: sellTab
      !tooltip: tr("List of items that you're able to sell")
      !text: tr('Sell')
      anchors.left: parent.horizontalCenter
      anchors.right: parent.right
      anchors.top: parent.top
      margin-left: 2

    TabButton
      id: blacklistTab
      !tooltip: tr("Items that Rashid must never sell")
      !text: tr('Blacklist')
      anchors.left: parent.horizontalCenter
      anchors.right: parent.right
      anchors.top: parent.top
      margin-left: 2
      visible: false

    TextEdit
      id: searchText
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: buyTab.bottom
      margin-top: 3
      height: 18
      !tooltip: tr('Search')
      @onTextChange: modules.game_npctrade.onSearchTextChange()

    Panel
      id: itemArea
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: searchText.bottom
      anchors.bottom: setupPanel.top
      margin-top: 3
      margin-bottom: 3
      border-width: 1
      border-color: #3a3a3a

      VerticalScrollBar
        id: itemsPanelListScrollBar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        step: 24
        pixels-scroll: true

      ScrollablePanel
        id: itemsPanel
        anchors.left: parent.left
        anchors.right: itemsPanelListScrollBar.left
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        vertical-scrollbar: itemsPanelListScrollBar
        margin: 2
        layout:
          type: grid
          cell-size: 146 58
          flow: true
          auto-spacing: true

    Panel
      id: setupPanel
      height: 82
      enabled: false
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: optionsPanel.top
      margin-bottom: 3
      border-width: 1
      border-color: #3a3a3a

      Label
        id: name
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        margin: 3 4 0 4
        text-align: center
        color: #d8b13b
        text-elide: true

      Label
        !text: tr('Price') .. ':'
        anchors.left: parent.left
        anchors.top: name.bottom
        margin-left: 4
        margin-top: 2

      NPCOfferLabel
        id: price
        anchors.left: prev.right
        anchors.top: prev.top
        margin-left: 3

      Label
        !text: tr('Gold') .. ':'
        anchors.left: parent.horizontalCenter
        anchors.top: prev.top
        margin-left: 1

      NPCOfferLabel
        id: money
        anchors.left: prev.right
        anchors.top: prev.top
        margin-left: 3

      Label
        id: weightDesc
        !text: tr('Weight') .. ':'
        anchors.left: parent.left
        anchors.top: name.bottom
        margin-left: 4
        margin-top: 17

      NPCOfferLabel
        id: weight
        anchors.left: prev.right
        anchors.top: prev.top
        margin-left: 3

      Label
        id: capacityDesc
        !text: tr('Cap') .. ':'
        anchors.left: parent.horizontalCenter
        anchors.top: prev.top
        margin-left: 1

      NPCOfferLabel
        id: capacity
        anchors.left: prev.right
        anchors.top: prev.top
        margin-left: 3

      HorizontalScrollBar
        id: quantityScroll
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin: 0 4 4 4
        show-value: true
        minimum: 1
        maximum: 100
        step: 1
        @onValueChange: modules.game_npctrade.onQuantityValueChange(self:getValue())

    Panel
      id: optionsPanel
      height: 40
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: actionPanel.top
      margin-bottom: 3

      CheckBox
        id: buyWithBackpack
        !text: tr('Buy with backpack')
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        @onCheckChange: modules.game_npctrade.onBuyWithBackpackChange()

      CheckBox
        id: ignoreCapacity
        !text: tr('Ignore capacity')
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 2
        @onCheckChange: modules.game_npctrade.onIgnoreCapacityChange()

      CheckBox
        id: ignoreEquipped
        !text: tr('Ignore equipped')
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        visible: false
        checked: true
        @onCheckChange: modules.game_npctrade.onIgnoreEquippedChange()

      CheckBox
        id: showAllItems
        !text: tr('Show all items')
        anchors.top: ignoreEquipped.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 2
        visible: false
        checked: true
        @onCheckChange: modules.game_npctrade.onShowAllItemsChange()

    Panel
      id: actionPanel
      height: 42
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom

      ProgressBar
        id: sellAllProgress
        height: 12
        background-color: #2f78c4
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        visible: false

      Label
        id: sellAllProgressLabel
        anchors.fill: sellAllProgress
        text-align: center
        color: #ffffff
        visible: false

      Button
        id: sellAllButton
        !text: tr('Sell All')
        width: 48
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        visible: false
        @onClick: modules.game_npctrade.sellAllLegacy()

      Button
        id: cancelSellAllButton
        !text: tr('Cancel')
        width: 48
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        visible: false
        @onClick: modules.game_npctrade.cancelRashidSellAllLegacy()

      Button
        id: tradeButton
        !text: tr('Buy')
        width: 48
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        @onClick: modules.game_npctrade.onTradeClick()
