Box < UIWidget
  border-width-top: 1
  border-color-top: black
  border-width-left: 1
  border-color-left: black
  border-width-bottom: 1
  border-color-bottom: gray
  border-width-right: 1
  border-color-right: gray
  image-smooth: true
  image-fixed-ratio: false

HistoryEntry < UIWidget
  anchors.top: parent.top
  anchors.right: parent.right
  margin-right: 8
  margin-top: 24
  size: 535 15
  background-color: #484848

  Label
    id: historyDate
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3

  Label
    id: historyBalance
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 147

  Label
    id: historyDescription
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 242

HomeOfferRow < StoreLightFlatPanel
  height: 72
  border: 1 #666666

  $focus:
    border: 1 #dedede

  Box
    id: image
    size: 66 66
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 3
    margin-left: 3

    UIWidget
      id: iconContent
      size: 52 52
      anchors.centerIn: parent

  UIWidget
    id: newBadge
    size: 30 30
    anchors.left: image.left
    anchors.bottom: image.bottom
    image-source: /game_store/images/store-new-ribbon
    phantom: true
    visible: false

  Label
    id: lblName
    anchors.top: parent.top
    anchors.left: image.right
    anchors.right: parent.right
    margin-top: 5
    margin-left: 6
    margin-right: 4
    height: 30
    font: verdana-11px-rounded
    color: #5ebd3c
    text-align: left
    text-wrap: true
    clipping: true

  Label
    id: lblOriginalPrice
    width: 43
    height: 19
    anchors.bottom: parent.bottom
    anchors.right: lblPrice.left
    margin-right: 2
    margin-bottom: 3
    font: Verdana-Strikethrough-11px
    color: #a9a9a9
    text-align: center
    visible: false

  StoreFlatPanel
    id: lblPrice
    size: 91 19
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 3
    margin-bottom: 3
    font: verdana-11px-rounded
    text-align: right
    text-offset: -19 0
    image-color: #171717c0
    icon: /images/ui/tibiaCoin
    icon-align: right
    icon-offset: -2 0

RowStore < StoreLightFlatPanel
  height: 78
  margin: 2
  border: 0 white

  $focus:
    border: 2 white

  Box
    id: image
    size: 64 64
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 5
    margin-left: 5

    UIWidget
      id: iconContent
      size: 52 52
      anchors.centerIn: parent

  UIWidget
    id: newBadge
    size: 30 30
    anchors.left: image.left
    anchors.bottom: image.bottom
    image-source: /game_store/images/store-new-ribbon
    phantom: true
    visible: false

  Label
    id: lblName
    anchors.top: parent.top
    anchors.left: image.right
    anchors.right: parent.right
    margin-top: 6
    margin-left: 8
    margin-right: 4
    height: 25
    font: verdana-11px-rounded
    color: #dfdfdf
    text-align: left
    text-wrap: true
    clipping: true

  Panel
    id: StackOffers
    anchors.left: image.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 8
    margin-right: 3
    margin-bottom: 3
    height: 20
    layout:
      type: verticalBox
      spacing: 2
MenuCategoryStore < UIWidget
  height: 22
  image-source: images/longButton
  image-border: 5
  margin: 3
  image-clip: 0 0 166 22
  text-align: left
  text-offset: 25 0
  text-wrap: true
  icon-align: left
  icon-offset: 6 0

  $pressed:
    text-offset: 25 0

  $focus:
    image-clip: 0 22 166 22

StoreWindow
  size: 780 537
  !text: tr('Store')
  color: #909090
  visible: false
  @onEscape: modules.game_store.toggle()

  StoreButton
    id: btnClose
    size: 45 20
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    !text: tr('Close')
    font: cipsoftFont
    @onClick: modules.game_store.toggle()

  StoreButton
    id: btnHistory
    size: 45 20
    anchors.bottom: parent.bottom
    anchors.right: btnClose.left
    margin-right: 5
    !text: tr('History')
    font: cipsoftFont
    @onClick: modules.game_store.toggleTransferHistory()

  Panel
    id: lblCoins
    size: 260 20
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 2
    image-color: #1111118c
    focusable: false
    phantom: true
    image-source: /game_store/images/panel
    image-border: 3
    Label
      id: lblTibiaCoins
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      focusable: false
      margin-left:22
      margin-bottom: 3
      text-auto-resize: true
      phantom: true

    UIWidget
      id: icono
      anchors.bottom: parent.bottom
      anchors.left: prev.right
      margin-left: 5
      margin-bottom: 3
      image-source: /images/ui/tibiaCoin
      focusable: false
      phantom: true

    Label
      id: lblTibiaTransfer
      anchors.bottom: parent.bottom
      anchors.left: prev.right
      text-auto-resize: true
      margin-left:5
      margin-bottom: 3 
      phantom: true

    UIWidget
      id: iconodos
      anchors.bottom: parent.bottom
      anchors.left: prev.right
      focusable: false
      phantom: true
      margin-left:5
      margin-bottom: 3
      image-source: images/icon-tibiacointransferable
    Label
      anchors.bottom: parent.bottom
      anchors.left: prev.right
      !text: tr(")")
      focusable: false
      phantom: true
      margin-left:5
      margin-bottom: 3 

  StoreButton
    id: btnCoins
    size: 64 20
    anchors.bottom: parent.bottom
    anchors.left: prev.right
    margin-left: 5
    margin-bottom: 2
    !tooltip: tr('Get Tibia Coins')
    image-color: green
    icon: /images/ui/tibiaCoin
    icon-align: center
    icon-offset: 10 -1
    text-offset: -10 0
    !text: tr('Get')
    font: cipsoftFont
    @onClick: modules.game_store.getCoinsWebsite()

    $pressed:
      text-offset: -18 0
      icon-offset: 10 0

  StoreButton
    id: transferPoints
    anchors.top: btnCoins.top
    !tooltip: tr('Transfer Coins')
    anchors.left: btnCoins.right
    margin-left: 5
    icon-align: center
    icon-source: images/iconTransfer
    size: 64 20

  StoreButton
    id: characterAuction
    anchors.top: transferPoints.top
    !tooltip: tr('Character sales are currently disabled.')
    anchors.left: transferPoints.right
    margin-left: 5
    icon-align: center
    icon-source: images/icon-trade
    size: 64 20
    enabled: false

  HorizontalSeparator
    anchors.bottom: prev.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 8

  UIScrollArea
    id: listCategory
    size: 190 450
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: prev.top
    image-source: images/panel
    image-border: 3
    auto-focus: none
    layout: verticalBox
    margin-bottom: 8
    padding: 5

  TextEdit
    id: SearchEdit
    anchors.bottom: listCategory.bottom
    anchors.left: parent.left
    margin-left: 5
    margin-bottom: 10
    height: 17
    width: 180
    placeholder: Type to search
    placeholder-color: #6E706F
    @onTextChange: modules.game_store.scheduleSearch(self:getText())
    @onEnter: modules.game_store.search(self:getText())

  UIWidget
    id: SearchClearButton
    anchors.right: SearchEdit.right
    anchors.top: SearchEdit.top
    margin-top: 1
    margin-right: 2
    image-source: /game_cyclopedia/images/button_clear_search
    image-color: white
    opacity: 0.8
    @onClick: modules.game_store.clearSearch()
    $hover:
      opacity: 1.0
      image-color: white
    $pressed:
      opacity: 1.0
      image-color: gray

  StoreLightFlatPanel
    id: panelItem
    anchors.top: parent.top
    anchors.left: listCategory.right
    anchors.right: parent.right
    anchors.bottom: listCategory.bottom
    margin-left: 8

    padding: 6

    UIWidget
      id: comboBoxContainer
      height: 20
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      layout: horizontalBox
      margin-right:22
      QtComboBox
        id: showAll
        width: 260
        height: 20
        mouse-scroll: false

      QtComboBox
        id: MostPopularFirst
        width: 260
        margin-left: 12
        height: 20
        mouse-scroll: false

    UIScrollArea
      id: listProduct
      size: 260 407
      anchors.top: comboBoxContainer.bottom
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      vertical-scrollbar: scrollList
      image-source: images/panel
      image-border: 3
      layout: verticalBox
      padding: 5
      margin-top:5
      auto-focus: none
    
    VerticalScrollBar
      id: scrollList
      anchors.top: listProduct.top
      anchors.bottom: listProduct.bottom
      anchors.left: listProduct.right
      step: 14
      pixels-scroll: true

    Label
      id: lblName
      anchors.top: comboBoxContainer.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-left: 140
      text-wrap: true
      text-auto-resize: true
      text-align: center
      text: Prismatic Unicorn
      margin-top:5

    Box
      id: image
      size: 96 96
      anchors.top: lblName.bottom
      anchors.left: scrollList.right
      margin: 8 0 0 8

    Panel
      id: StackOffers
      anchors.top: prev.top
      anchors.left: prev.right
      anchors.right: parent.right
      margin-left: 10
      layout:
        type: grid
        cell-size: 145 50
        cell-spacing: 3
        flow: true
        fit-children: true

    UIWidget
      id: descriptionPanel
      image-source: /game_store/images/panel_flat
      image-border: 1
      clipping: true
      anchors.top: image.bottom
      anchors.left: scrollList.right
      anchors.right: parent.right
      anchors.bottom: scrollList.bottom
      margin-left: 8
      margin-top: 7

      VerticalScrollBar
        id: descriptionScrollbar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        step: 14
        pixels-scroll: true

      UIScrollArea
        id: descriptionScrollArea
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: descriptionScrollbar.left
        vertical-scrollbar: descriptionScrollbar
        padding: 3
        layout: verticalBox

  QtPanel
    id: transferHistory
    anchors.top: parent.top
    anchors.left: listCategory.right
    anchors.right: parent.right
    anchors.bottom: listCategory.bottom
    margin-left:10
    visible: false

    Panel
      id: historyPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-bottom: 22
      background-color: #363636
      border: 1 black
      layout:
        type: verticalBox

    Button
      id: btnNextPage
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-bottom:-5
      !text: tr('Next Page')
      @onClick: modules.game_store.requestTransactionHistory(self)

    Label
      id: lblPage
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      !text: tr('Page 1 / 4')

    Button
      id: btnPrevPage
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin-bottom:-5
      !text: tr('Prev Page')
      @onClick: modules.game_store.requestTransactionHistory(self)

  StoreLightFlatPanel
    id: HomePanel
    anchors.top: parent.top
    anchors.left: listCategory.right
    anchors.right: parent.right
    anchors.bottom: listCategory.bottom
    margin-left: 8
    padding: 6

    VerticalScrollBar
      id: homeScroll
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      step: 36
      pixels-scroll: true

    UIScrollArea
      id: HomeContent
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: homeScroll.left
      margin-right: 3
      vertical-scrollbar: homeScroll
      auto-focus: none
      layout:
        type: verticalBox
        spacing: 9

      UIWidget
        id: HomeBanner
        height: 188
        image-source: /game_store/images/store-banner-arcane-bag
        image-smooth: true
        image-fixed-ratio: false

        UIButton
          id: prevBanner
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 5
          size: 16 29
          image-source: /game_store/images/button-featured-offers-left
          @onClick: modules.game_store.changeHomeBanner(-1)
          $hover:
            image-source: /game_store/images/button-featured-offers-left-highlight

        UIButton
          id: nextBanner
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          margin-right: 5
          size: 16 29
          image-source: /game_store/images/button-featured-offers-right
          @onClick: modules.game_store.changeHomeBanner(1)
          $hover:
            image-source: /game_store/images/button-featured-offers-right-highlight
      MiniPanel
        id: HomePromotions
        height: 125
        text: Promotions - 20% OFF

        Panel
          id: PromotionProducts
          anchors.fill: parent
          auto-focus: none
          layout:
            type: grid
            cell-size: 245 72
            cell-spacing: 4
            flow: true

      MiniPanel
        id: HomeRecentlyAdded
        height: 125
        text: Most Purchased

        Panel
          id: HomeProductos
          anchors.fill: parent
          auto-focus: none
          layout:
            type: grid
            cell-size: 245 72
            cell-spacing: 4
            flow: true
